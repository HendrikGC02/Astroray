{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Astroray: Configure CUDA",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--preset",
        "windows-cuda-vs"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Astroray: Build CUDA Release",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "windows-cuda-vs-release"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Astroray: Showcase (quick, GPU)",
      "type": "shell",
      "command": "python",
      "args": [
        "benchmarks/showcase/render_showcase.py",
        "--quick",
        "--gpu",
        "--output-dir",
        "test_results/showcase"
      ],
      "dependsOn": [
        "Astroray: Build CUDA Release"
      ],
      "problemMatcher": []
    },
    {
      "label": "Astroray: Showcase (quick, CPU)",
      "type": "shell",
      "command": "python",
      "args": [
        "benchmarks/showcase/render_showcase.py",
        "--quick",
        "--output-dir",
        "test_results/showcase_cpu"
      ],
      "dependsOn": [
        "Astroray: Build CUDA Release"
      ],
      "problemMatcher": []
    },
    {
      "label": "Astroray: Standalone Smoke (GPU)",
      "type": "shell",
      "command": "python",
      "args": [
        "scripts/dev/run_standalone.py",
        "--scene",
        "1",
        "--width",
        "128",
        "--height",
        "128",
        "--samples",
        "16",
        "--depth",
        "8",
        "--device",
        "gpu",
        "--output",
        "test_results/standalone_gpu_smoke.png"
      ],
      "dependsOn": [
        "Astroray: Build CUDA Release"
      ],
      "problemMatcher": []
    }
  ]
}
